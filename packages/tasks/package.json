{
	"name": "@axium/tasks",
	"version": "0.5.12",
	"author": "James Prevett <axium@jamespre.dev>",
	"description": "Tasks for Axium",
	"funding": {
		"type": "individual",
		"url": "https://github.com/sponsors/james-pre"
	},
	"license": "LGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/james-pre/axium.git"
	},
	"homepage": "https://github.com/james-pre/axium#readme",
	"bugs": {
		"url": "https://github.com/james-pre/axium/issues"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js",
		"./components": "./lib/index.js",
		"./components/*": "./lib/*.svelte"
	},
	"files": [
		"db-scripts",
		"dist",
		"lib",
		"routes",
		"locales",
		"db.json"
	],
	"scripts": {
		"build": "tsc"
	},
	"peerDependencies": {
		"@axium/client": ">=0.41.0",
		"@axium/core": ">=0.43.0",
		"@axium/server": ">=0.58.0",
		"@james-pre/locales": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"kysely": "^0.29.0",
		"utilium": "^3.0.0"
	},
	"dependencies": {
		"zod": "^4.0.5"
	},
	"axium": {
		"locales": "locales",
		"server": {
			"routes": "routes",
			"hooks": "./dist/hooks.js",
			"db": "./db.json",
			"web_client_hooks": "./dist/common.js"
		},
		"apps": [
			{
				"id": "tasks",
				"name": "Tasks",
				"icon": "list-check"
			}
		],
		"update_checks": true,
		"access_controls": {
			"task_lists": {
				"permissions": {
					"read": {
						"default": true
					},
					"edit": {
						"implies": [
							"read"
						]
					},
					"manage": {
						"implies": [
							"read",
							"edit"
						]
					}
				},
				"notifications": {
					"enabled": true,
					"name": "{name}",
					"url": "/tasks/{id}"
				},
				"presets": {
					"reader": [
						"read"
					],
					"editor": [
						"read",
						"edit"
					],
					"manager": [
						"read",
						"edit",
						"manage"
					]
				}
			}
		}
	}
}
