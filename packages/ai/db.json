{
	"$schema": "../server/schemas/db.json",
	"format": 1,
	"versions": [
		{
			"delta": false,
			"tables": {
				"ai_models": {
					"columns": {
						"id": { "type": "text", "required": true, "primary": true },
						"name": { "type": "text", "required": true },
						"source": { "type": "text", "required": true },
						"size": { "type": "bigint", "required": true, "default": "0" },
						"created": { "type": "timestamptz", "required": true, "default": "now()" },
						"isDefault": { "type": "boolean", "required": true, "default": "false" },
						"reasoning": { "type": "text" },
						"systemPrompt": { "type": "text" },
						"options": { "type": "jsonb", "required": true, "default": "'{}'::jsonb" },
						"reasoningLevels": { "type": "text[]" },
						"templateReasoning": { "type": "text" },
						"tools": { "type": "boolean" },
						"learned": { "type": "timestamptz" }
					}
				},
				"ai_conversations": {
					"columns": {
						"id": { "type": "uuid", "required": true, "primary": true, "default": "gen_random_uuid()" },
						"userId": { "type": "uuid", "required": true, "references": "users.id", "onDelete": "cascade" },
						"title": { "type": "text", "required": true, "default": "''" },
						"titleSource": {
							"type": "text",
							"required": true,
							"default": "'none'",
							"check": "\"titleSource\" IN ('none', 'auto', 'user')"
						},
						"model": { "type": "text", "references": "ai_models.id", "onDelete": "set null" },
						"reasoning": { "type": "text", "required": true, "default": "'default'" },
						"created": { "type": "timestamptz", "required": true, "default": "now()" },
						"modified": { "type": "timestamptz", "required": true, "default": "now()" },
						"allowedTools": { "type": "text[]", "required": true, "default": "'{}'" }
					}
				},
				"ai_messages": {
					"columns": {
						"id": { "type": "uuid", "required": true, "primary": true, "default": "gen_random_uuid()" },
						"conversationId": { "type": "uuid", "required": true, "references": "ai_conversations.id", "onDelete": "cascade" },
						"created": { "type": "timestamptz", "required": true, "default": "now()" },
						"role": { "type": "text", "required": true, "check": "role IN ('user', 'assistant', 'tool')" },
						"content": { "type": "text", "required": true, "default": "''" },
						"reasoning": { "type": "text" },
						"toolCalls": { "type": "jsonb" },
						"toolCallId": { "type": "text" },
						"status": {
							"type": "text",
							"required": true,
							"default": "'done'",
							"check": "status IN ('pending', 'done', 'error', 'cancelled', 'awaiting')"
						},
						"error": { "type": "text" },
						"usage": { "type": "jsonb" }
					}
				},
				"ai_memories": {
					"columns": {
						"userId": { "type": "uuid", "required": true, "references": "users.id", "onDelete": "cascade", "primary": true },
						"id": { "type": "text", "required": true, "primary": true },
						"description": { "type": "text", "required": true },
						"content": { "type": "text", "required": true, "default": "''" },
						"source": {
							"type": "text",
							"required": true,
							"default": "'user'",
							"check": "source IN ('user', 'explicit', 'inferred', 'periodic')"
						},
						"conversationId": { "type": "uuid", "references": "ai_conversations.id", "onDelete": "set null" },
						"created": { "type": "timestamptz", "required": true, "default": "now()" },
						"modified": { "type": "timestamptz", "required": true, "default": "now()" }
					}
				}
			},
			"indexes": {
				"ai_conversations_userId": { "on": "ai_conversations", "columns": ["userId"] },
				"ai_messages_conversationId": { "on": "ai_messages", "columns": ["conversationId"] }
			}
		}
	],
	"wipe": ["ai_memories", "ai_messages", "ai_conversations", "ai_models"]
}
