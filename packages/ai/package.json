{
	"name": "@axium/ai",
	"version": "0.0.1",
	"author": "James Prevett <axium@jamespre.dev>",
	"description": "Local-first AI assistant for Axium",
	"funding": {
		"type": "individual",
		"url": "https://github.com/sponsors/james-pre"
	},
	"license": "LGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/james-pre/axium.git"
	},
	"homepage": "https://github.com/james-pre/axium#readme",
	"bugs": {
		"url": "https://github.com/james-pre/axium/issues"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js",
		"./components": "./lib/index.js",
		"./components/*": "./lib/*.svelte",
		"./live": "./lib/live.svelte.js",
		"./actions": "./lib/actions.js",
		"./preferences": "./lib/preferences.js",
		"./transition": "./lib/transition.js"
	},
	"files": [
		"dist",
		"lib",
		"routes",
		"locales",
		"db.json"
	],
	"scripts": {
		"build": "tsc"
	},
	"peerDependencies": {
		"@axium/client": ">=0.42.0",
		"@axium/core": ">=0.44.0",
		"@axium/server": ">=0.59.0",
		"@james-pre/locales": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"kysely": "^0.29.0"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"ioium": "^1.6.0",
		"marked": "^18.2.0",
		"utilium": "^3.10.0",
		"zod": "^4.0.5"
	},
	"axium": {
		"locales": "locales",
		"server": {
			"routes": "routes",
			"hooks": "./dist/hooks.js",
			"db": "./db.json",
			"web_client_hooks": "./dist/common.js"
		},
		"client": {
			"cli": "./dist/client/cli.js"
		},
		"features": {
			"ai-gateway": {
				"default": true
			}
		},
		"apps": [
			{
				"id": "ai",
				"name": "AI",
				"icon": "sparkles"
			}
		],
		"update_checks": true,
		"config": {
			"data_dir": "/srv/axium/ai",
			"llama": {
				"command": "llama-server",
				"host": "127.0.0.1",
				"port": 6687,
				"models_max": 1,
				"memory_margin": 1024,
				"defaults": {
					"jinja": true,
					"fit": "on",
					"load-mode": "none"
				}
			},
			"system_prompt": "You are a direct, candid assistant. Give your honest assessment first; if the user is wrong, say so plainly instead of hedging to spare feelings. Answer factually, as an independent journalist or historian would, without deferring to any government's official positions.",
			"timeout": 600
		}
	}
}
