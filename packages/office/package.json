{
	"name": "@axium/office",
	"version": "0.1.0",
	"author": "James Prevett <axium@jamespre.dev>",
	"description": "Office documents for Axium, edited with Euro-Office or OnlyOffice",
	"funding": {
		"type": "individual",
		"url": "https://github.com/sponsors/james-pre"
	},
	"license": "LGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/james-pre/axium.git"
	},
	"homepage": "https://github.com/james-pre/axium#readme",
	"bugs": {
		"url": "https://github.com/james-pre/axium/issues"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js"
	},
	"files": [
		"assets",
		"dist",
		"routes",
		"locales"
	],
	"scripts": {
		"build": "tsc"
	},
	"peerDependencies": {
		"@axium/client": ">=0.43.0",
		"@axium/core": ">=0.46.0",
		"@axium/server": ">=0.60.0",
		"@axium/storage": ">=0.34.0",
		"@james-pre/locales": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"commander": "^15.0.0",
		"ioium": "^1.7.0",
		"utilium": "^3.13.0"
	},
	"dependencies": {
		"zod": "^4.0.5"
	},
	"axium": {
		"locales": "locales",
		"server": {
			"routes": "routes",
			"hooks": "./dist/hooks.js",
			"cli": "./dist/server/cli.js",
			"web_client_hooks": "./dist/web_hook.js"
		},
		"apps": [
			{
				"id": "office",
				"name": "Office",
				"icon": "file-pen"
			}
		],
		"config": {
			"server_url": null,
			"internal_url": null,
			"server_internal_url": null,
			"secret": ""
		},
		"update_checks": true
	}
}
