{
	"extends": ["../tsconfig.json", "$app/tsconfig"],
	"compilerOptions": {
		"typeRoots": null,
		"moduleResolution": "bundler",
		"module": "esnext",
		"noEmit": true,
		"target": "esnext",
		"rootDir": ".."
	},
	"include": ["**/*", "../lib/*", "../src/.*.ts", "../../client/dist/.*.ts"],
	"references": [{ "path": ".." }]
}
